{
  "base_model_path": "runtime/models/Qwen3-8B-Instruct",
  "bf16": true,
  "chat_template": true,
  "early_stopping_patience": 3,
  "early_stopping_threshold": 0.001,
  "eval_steps": 50,
  "eval_strategy": "steps",
  "fp16": false,
  "gradient_accumulation_steps": 8,
  "gradient_checkpointing": true,
  "greater_is_better": false,
  "learning_rate": 0.0001,
  "load_best_model_at_end": true,
  "load_in_4bit": false,
  "load_in_8bit": false,
  "logging_steps": 10,
  "lora_alpha": 64,
  "lora_dropout": 0.1,
  "lora_r": 32,
  "lr_scheduler_type": "cosine",
  "max_grad_norm": 0.5,
  "max_seq_length": 1280,
  "metric_for_best_model": "eval_loss",
  "num_train_epochs": 2,
  "optim": "paged_adamw_32bit",
  "per_device_eval_batch_size": 1,
  "per_device_train_batch_size": 1,
  "report_to": "tensorboard",
  "save_steps": 50,
  "save_strategy": "steps",
  "save_total_limit": 4,
  "seed": 42,
  "target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "train_test_split": 0.9,
  "truncation_direction": "left",
  "warmup_ratio": 0.05,
  "weight_decay": 0.01
}
