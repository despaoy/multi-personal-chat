# ============================================
# QQ 智能助手 - 环境变量配置模板
# ============================================
# 此模板用于后端/裸机配置；后端固定从 backend/.env 加载。
# Docker Compose 的变量插值文件固定为 deploy/.env，两者不要混用。
# Next.js 本地变量（如 BACKEND_URL）使用仓库根目录 .env.local，
# 也可由部署平台直接注入。
#
# 快速开始：
#   cp .env.example backend/.env && 编辑 backend/.env
#   cp .env.example deploy/.env  && 编辑 deploy/.env（Docker Compose）

# === 运行环境 ===
# 开发: development | 生产: production
ENVIRONMENT=development

# === 前端（Next.js）===
BACKEND_URL=http://localhost:8000

# === vLLM 推理服务 ===
# VLLM_SERVED_MODEL_NAME 必须与 vLLM --served-model-name 完全一致
VLLM_BASE_URLS=http://localhost:8001
VLLM_SERVED_MODEL_NAME=qwen3-8b-instruct-awq
VLLM_TIMEOUT=120
VLLM_MAX_RETRIES=3
VLLM_ENABLED=true
# Qwen3-8B 原生 32K 上限下，为 24GB 显卡上的 LoRA、embedding 与
# 可选 reranker 留出显存。后端与 vLLM 必须使用同一个值；
# 若实际服务以 8192 启动，这里也必须改为 8192。后端未配置时保守使用 8192。
VLLM_MAX_MODEL_LEN=24576
VLLM_MAX_NUM_SEQS=8

# === 动态上下文语义复核 ===
# 以下状态复核、记忆选择和策略选择默认关闭；开启后使用当前请求选择的
# vLLM 或 OpenAI 兼容基础模型，分别执行独立审核。
# 输出守卫默认轻量处理：风格提示不触发额外生成；安全/事实/明确边界仍检查。
# 状态复核按既有触发条件执行；安全分支不追加状态复核请求。
# 历史保留完整用户轮次：本地默认最多 6 条消息，云端按实际工作窗口调整。
# 超时、服务异常、非法结构或完整输入超预算会使上下文准备失败，由 API 明确报错。
# 审核可能将对话数据发送到所选模型服务，启用前需确认其隐私政策并完成评测。
DYNAMIC_CONTEXT_SEMANTIC_REVIEW_ENABLED=false
DYNAMIC_CONTEXT_SEMANTIC_REVIEW_TIMEOUT_SECONDS=5.0

# 情境感知记忆选择：复用当前请求的基础模型，审核完整授权候选及最近对话。
# 候选超过 24 条、预算不足、超时或非法输出均明确失败，不静默丢弃候选。
# 不解除主体、生命周期与证据边界。部署前完成真实模型评测及隐私审核。
CONTEXTUAL_MEMORY_SELECTION_ENABLED=false
CONTEXTUAL_MEMORY_SELECTION_TIMEOUT_SECONDS=30
# 人设参与策略选择；只允许兼容的固定策略 ID，保留安全、明确任务和用户边界约束。
# 安全保护或两项必要任务占满槽位时不追加策略审核；其余审核故障明确报错。
CONTEXTUAL_DECISION_POLICY_ENABLED=false
# 多粒度角色 RAG 独立开关；初次真实开发集测试中原文精排退化，暂不推荐启用。
CHARACTER_RAG_RERANKER_ENABLED=false
# Experimental model-input view: content / summary / embedding_text. Keep off until evaluated.
CHARACTER_RAG_RERANK_TEXT_VIEW=content
# 此门槛使用原始 logit，不是概率；必须在独立验证集校准后才提升到生产。
CHARACTER_RAG_CROSS_ENCODER_MIN_LOGIT=0.0

# === 后台长期记忆判断（可选）===
# 普通发言在成功回复后排队，由独立的 OpenAI 兼容记忆模型提出结构化提案，
# 并校验来源、归属与生命周期；显式删除请求在回复生成前处理并提供操作回执。
# MEMORY_LLM_BASE_URL / MEMORY_LLM_MODEL 优先；未设置时继承 vLLM 配置，
# 不随主答模型提供商自动切换。外部服务会收到用户消息，启用前需确认隐私政策。
# 启用但地址/模型缺失或数值非法时配置校验失败；任务故障通过回执报告，不转为规则写入。
MEMORY_LLM_ENABLED=false
# MEMORY_LLM_BASE_URL=http://localhost:8001
# MEMORY_LLM_MODEL=qwen3-8b-instruct-awq
MEMORY_LLM_TIMEOUT=30
MEMORY_LLM_QUEUE_SIZE=64
# 默认按完整请求预算：继承 VLLM_MAX_MODEL_LEN（未配置时 8192）。
# 外部 writer 模型可单独指定其实际服务窗口，不是模型理论最大值。
# MEMORY_LLM_CONTEXT_WINDOW_TOKENS=8192
# 显式设为 0 才使用以下旧字符预算；不会截断消息，超限会明确失败。
MEMORY_LLM_MAX_INPUT_CHARS=2000
MEMORY_LLM_CONFIDENCE_THRESHOLD=0.85
# 普通陈述按用户作用域缓冲：空闲 2 秒或累计 4 条即批量提交后台 worker；
# 显式“记住”、纠错与删除请求仍走即时 hot path。
MEMORY_LLM_IDLE_SECONDS=2.0
MEMORY_LLM_BATCH_SIZE=4
MEMORY_LLM_SHUTDOWN_TIMEOUT=10
# 完整原话独立检索仍为受控评测功能；不会将原话标作已确认用户事实。
# 开启前需验证来源索引、遗忘范围、预算及人物归属，默认关闭。
MEMORY_SOURCE_RECALL_ENABLED=false
# MEMORY_LLM_API_KEY=仅在独立记忆服务要求鉴权时设置

# CAHM 上下文感知混合长期记忆检索：启用语义通道后使用配置的 embedding 模型。
# 模型加载、编码或向量校验失败会明确报错，不自动转为 bigram 检索。
# 显式关闭语义通道后仍保留其他检索通道及生命周期、主体和证据约束。
CAHM_SEMANTIC_MEMORY_ENABLED=true
# Recall ranks all authorized records before selecting prompt evidence.
# Legacy bounded recall is available only through explicit candidate_limit in offline ablations.
MIN_HYBRID_MEMORY_SCORE=0.35
MIN_MEMORY_CLAIM_CONFIDENCE=0.45
# 推荐平衡检索开关；构造 CharacterMemoryService 时显式传值可覆盖环境配置。
# 关闭版本过滤或证据包仅用于受控消融；情境感知记忆选择始终执行这两项边界。
CAHM_RRF_ENABLED=true
CAHM_QUERY_EXPANSION_ENABLED=true
CAHM_VERSION_FILTER_ENABLED=true
CAHM_EVIDENCE_ENABLED=true

# === 模型提供商 ===
# 可选: vllm / ollama / openai_compat
MODEL_PROVIDER=vllm

# === HuggingFace 国内镜像（加速模型下载）===
# 设为 https://hf-mirror.com 使用国内镜像
HF_ENDPOINT=https://hf-mirror.com

# === 模型与 LoRA 路径 ===
# 模型管理 API 的下载/扫描根目录；相对路径以 backend/ 为基准。
MODEL_STORAGE_PATH=./models
# MODEL_PATH 为相对 backend/ 的路径；实验室部署可把 backend/models 软链到模型盘
# 默认使用 AWQ 4bit 量化模型（单卡 3090 约 14GB 显存）
MODEL_PATH=./models/Qwen3-8B-Instruct-AWQ
# LORA_PATH 是后端进程扫描适配器时看到的路径。
LORA_PATH=./loras
# VLLM_LORA_ROOT 是后端请求 vLLM 加载适配器时发送的路径。
# 裸机模式通常与 LORA_PATH 相同；容器模式可以是同一存储的不同挂载点。
VLLM_LORA_ROOT=./loras
# 受信任的 LoRA 真实根目录（逗号分隔）。LORA_ROOT 下允许存在指向这些目录
# 的符号链接；未列入的根外符号链接目标会被拒绝，防止任意链接把适配器
# 指向受信边界之外的位置。留空时仅允许 LORA_ROOT 本身。
# LORA_ALLOWED_REAL_ROOTS=/lab/qqchat-data/loras

# === 数据库（SQLite 默认）===
DATABASE_PATH=./qq_assistant.db
# BACKUP_DIR=./backups  # 相对路径以数据库所在目录为基准
# PostgreSQL 生产模式（二选一）：
# 1. 使用完整 URL；密码中的保留字符必须进行 URL 编码。
# USE_POSTGRESQL=true
# DATABASE_URL=postgresql+asyncpg://user:encoded-password@host:5432/qqassistant
# 2. 使用 PG_* 分量；应用会安全编码密码，Docker Compose 推荐此方式。
# PG_HOST=postgres
# PG_PORT=5432
# PG_USER=qqassistant
# PG_PASSWORD=raw-strong-password
# PG_DATABASE=qqassistant

# === 向量数据库 ===
VECTOR_DB_PATH=./vector_db
# Curated character-domain index. Generate it with
# backend/scripts/build_character_rag_index.py before enabling character RAG.
# Leave unset to use the repository-local default, or set an absolute deployment path.
# CHARACTER_RAG_INDEX_ROOT=/absolute/path/to/character_knowledge_index_v3
CHARACTER_RAG_ABSTAIN_THRESHOLD=0.25
# Experimental independent memory/identity task execution. Paired real-model
# tests found longer, less factual identity answers; leave disabled by default.
CHARACTER_INDEPENDENT_TASKS_ENABLED=false


# === Persistent server runtime layout (Linux lab example) ===
# Keep these outside the Git-managed application directory.
# DATABASE_PATH=/lab/qqchat-data/db/qq_assistant.db
# VECTOR_DB_PATH=/lab/qqchat-data/rag/vector_db
# CHARACTER_RAG_INDEX_ROOT=/lab/qqchat-data/rag/character_knowledge_index_v3
# LORA_PATH=/lab/qqchat-data/loras
# VLLM_LORA_ROOT=/lab/qqchat-data/loras
# EMBEDDING_MODEL_PATH=/lab/models/paraphrase-multilingual-MiniLM-L12-v2
# INTENT_MODEL_PATH=/lab/qqchat-data/intent/classifier
# INTENT_SAMPLES_PATH=/lab/qqchat-data/intent/samples
# === Redis 缓存（生产用）===
# RERANKER_MODEL_PATH=/lab/models/bge-reranker-base
# RERANKER_ENABLED=false
# REDIS_URL=redis://localhost:6379/0

# === 安全配置 ===
# JWT 密钥：所有环境必须显式设置至少 32 字符的非占位密钥；多实例需统一。
# 应用不会生成或写回。可手动生成后保存到 backend/.env：
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=your-48-char-secure-secret-here-change-in-production
JWT_ALGORITHM=HS256
# Production allows only the first bootstrap user unless explicitly enabled.
ALLOW_PUBLIC_REGISTRATION=false
# API Keys（逗号分隔，用于 API Key 认证）
# API_KEYS=key1,key2,key3
# API_KEY_AUTH_RPM=60  # 每 IP 每分钟最多 API Key 校验次数
# 数据加密密钥（EncryptionManager 使用 AES-256-GCM）。
# 所有环境都必须显式配置并妥善备份；缺失时应用报错，不生成替代密钥。
# 生成命令: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# ENCRYPTION_KEY=replace-with-url-safe-base64-encoded-32-byte-key

# === 限流配置 ===
RATE_LIMIT_RPM=300
RATE_LIMIT_TPM=500000
GENERATE_RPM=60
GENERATE_TPM=500000
# Direct/bare backend authentication limit. Bundled Compose uses Nginx's
# fixed 10 RPM per direct client and the aggregate backend guard below.
AUTH_RPM=10
# Aggregate guard after all requests traverse the Next.js proxy.
BACKEND_PROXY_AUTH_AGGREGATE_RPM=10000
RATE_LIMIT_MAX_KEYS=10000
RATE_LIMIT_CLEANUP_INTERVAL=64
RATE_LIMIT_CLEANUP_BATCH_SIZE=64
# Enable only when the backend is reachable exclusively through a trusted reverse proxy.
TRUST_PROXY_HEADERS=false

# === 输入验证 ===
MAX_BODY_SIZE=1048576
PROMPT_MAX_LENGTH=10000

# === 审计日志 ===
AUDIT_LOG_DIR=./logs

# === 安全中间件开关 ===
SECURITY_MIDDLEWARE_ENABLED=true

# === CORS ===
# 开发环境
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000
# 生产环境改为实际域名（逗号分隔）
# ALLOWED_ORIGINS=https://your-domain.com
# 仅为兼容旧配置，未设置 ALLOWED_ORIGINS 时仍接受 CORS_ORIGINS。

# === 日志级别（DEBUG / INFO / WARNING / ERROR）===
LOG_LEVEL=INFO
BACKEND_WORKERS=1
# Single-worker admission control. Tune only from measured load tests.
BACKEND_LIMIT_CONCURRENCY=256
BACKEND_BACKLOG=512
BACKEND_KEEPALIVE_TIMEOUT=10


# === Inference admission control ===
# Queue workers bound admitted jobs; client limits protect each inference backend.
INFERENCE_WORKERS=2
INFERENCE_QUEUE_MAX_SIZE=100
INFERENCE_QUEUE_TIMEOUT=180
LLM_MAX_CONCURRENCY=2
VLLM_MAX_CONCURRENCY=2
CHAT_GLOBAL_QPS=20
CHAT_GLOBAL_BURST=40
CHAT_CONVERSATION_QPS=1
CHAT_CONVERSATION_BURST=5
CHAT_SENDER_QPS=0.5
CHAT_SENDER_BURST=3
SESSION_SWITCH_CACHE_TTL=60
SESSION_SWITCH_CACHE_MAX_SIZE=4096

# === Dashboard observability cache ===
# Collapse concurrent dashboard polls and avoid repeated GPU subprocess probes.
STATS_CACHE_TTL_SECONDS=5
STATS_RESOURCE_CACHE_TTL_SECONDS=15
# GPU metrics use nvidia-smi directly; failed probes report errors.
# Cache TTL 0 disables caching. Alert thresholds 0 trigger immediately.
# Queue ratio must be within [0, 1]; other thresholds must be nonnegative.
ALERT_RESPONSE_P95_SECONDS=30
ALERT_QUEUE_RATIO=0.8
ALERT_AUTH_FAILURES_5M=10
ALERT_DB_FAILURES_5M=1
ALERT_MODEL_CONSECUTIVE_FAILURES=3

# === Authentication blocking-work isolation ===
# Bound CPU-heavy bcrypt work so it cannot starve the shared async worker pool.
AUTH_PASSWORD_WORKERS=2
AUTH_PASSWORD_MAX_PENDING=8
AUTH_PASSWORD_TIMEOUT_SECONDS=10
AUTH_DATABASE_WORKERS=8
AUTH_DATABASE_MAX_PENDING=32
AUTH_DATABASE_TIMEOUT_SECONDS=5

# Bound disk/CPU-heavy dataset ZIP exports.
TRAINING_EXPORT_MAX_CONCURRENCY=2
TRAINING_EXPORT_ACQUIRE_TIMEOUT=1

# === 工具配置 ===
# 文件发送目录（Linux 默认用户 Home，Windows 默认 Desktop）
# Research automation (optional; never commit real credentials).
# Export these in the shell that runs the script.
# DEEPSEEK_API_KEY=replace-with-a-rotated-key
# DEEPSEEK_API_KEYS=key-a,key-b

# === Kisaki V3 LLM sample regeneration pipeline ===
# Generator + Judge B (pairwise) use DeepSeek; Judge A (5-dim semantic) uses Qwen.
# Different model families => can claim "independent multi-Judge committee".
# Generator and Judge B sharing the same model is a known self-preference risk,
# documented in judge_config.json under "cross_model_committee_note".

# Qwen (DashScope OpenAI-compatible endpoint) — for Judge A
# Get from https://dashscope.console.aliyun.com/apiKey
# QWEN_API_KEY=sk-...
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_JUDGE_A_MODEL=qwen3-max-2026-01-23

# DeepSeek — for Generator and Judge B
# Get from https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_GENERATOR_MODEL=deepseek-v4-flash
DEEPSEEK_JUDGE_B_MODEL=deepseek-v4-pro

# Embedding model for original-copy detection (semantic similarity).
# Defaults to local bge-small-zh-v1.5 to avoid extra API calls.
KISAKI_EMBEDDING_MODEL_PATH=./models/bge-small-zh-v1.5
# Similarity backend mode:
#   strict   (default, for Pilot/formal): pipeline stops if BGE model missing
#   fallback (local dev/test only): uses char 4-gram cosine, tagged non-authoritative
KISAKI_SIMILARITY_BACKEND=strict
LORA_ABLATION_TRAIN_DATA=backend/data/character_dialogues/experiments/v4/train.jsonl
# LAB_HOST=your-lab-host
# LAB_USER=your-lab-user
# LAB_SSH_KEY=~/.ssh/id_ed25519
# LAB_PASS=use-only-when-key-auth-is-unavailable
LAB_SSH_AUTO_ADD_HOST_KEY=false

# SEND_FILE_DIR=/home/user/send_files
# Production default: disabled. Enable only inside a locked-down container.
CLAW_CODE_EXECUTION_ENABLED=false
CLAW_EXECUTION_TIMEOUT=3

# === AstrBot multi-platform gateway ===
# The shared token is server-only and configured once in the security section below.
# AstrBot management/listen port used by service status checks.
ASTRBOT_PORT=6185
# Variables consumed by astrbot_plugins/multipersonal_gateway when installed in AstrBot.
# MULTIPERSONAL_* is the canonical prefix; legacy QQCHAT_* aliases remain supported.
MULTIPERSONAL_BACKEND_URL=http://127.0.0.1:8000
# QQCHAT_BACKEND_URL=http://127.0.0.1:8000
MULTIPERSONAL_TRIGGER_PREFIXES=/ai,/chat,@bot
# QQCHAT_TRIGGER_PREFIXES=/ai,/chat,@bot
MULTIPERSONAL_REPLY_GROUP_ALL=false
# QQCHAT_REPLY_GROUP_ALL=false
MULTIPERSONAL_BACKEND_TIMEOUT=210
# QQCHAT_BACKEND_TIMEOUT=210

# Reliability controls for AstrBot/backend boundary
ASTRBOT_ENABLED=true
ASTRBOT_QQ_ENABLED=true
ASTRBOT_TELEGRAM_ENABLED=true
ASTRBOT_WECOM_ENABLED=true
ASTRBOT_WECHAT_OFFICIAL_ENABLED=true
ASTRBOT_WECHAT_PERSONAL_ENABLED=false
MULTIPERSONAL_DEDUP_TTL=300
# QQCHAT_DEDUP_TTL=300
INTEGRATION_AUTH_TIMEOUT=3
INTEGRATION_DB_TIMEOUT=3
MODEL_INFERENCE_TIMEOUT=180
RAG_TIMEOUT=8
# Returned without invoking the LLM when retrieval confidence is below the abstention threshold.
RAG_ABSTENTION_REPLY=我没有找到足够可靠的信息，暂时无法回答这个问题。
RAG_QUERY_CACHE_TTL=60
RAG_RETRIEVAL_CACHE_TTL=60
DB_WRITE_TIMEOUT=3

# Security controls for external integrations
# Production requires at least one non-empty AstrBot integration token.
# ASTRBOT_INTEGRATION_TOKEN=change-me-to-a-random-secret
# Optional comma-separated token rotation list; keep old and new during rotation.
# ASTRBOT_INTEGRATION_TOKENS=old-token,new-token
INTEGRATION_SIGNATURE_REQUIRED=false
INTEGRATION_SIGNATURE_SKEW_SECONDS=300
INTEGRATION_NONCE_TTL_SECONDS=300
INTEGRATION_NONCE_CACHE_MAX=10000
ASTRBOT_RAW_MAX_BYTES=65536


# === Production required deployment variables ===
# Set these explicitly before ENVIRONMENT=production. Do not keep placeholder values.
# ASTRBOT_INTEGRATION_TOKEN=replace-with-a-long-random-shared-secret
# MULTIPERSONAL_BACKEND_URL=http://backend:8000
# QQCHAT_BACKEND_URL=http://backend:8000  # legacy alias
# DATABASE_URL=postgresql+asyncpg://qqassistant:url-encoded-password@postgres:5432/qqassistant  # 或使用上方 PG_*
# VLLM_BASE_URL=http://vllm:8001
# JWT_SECRET=replace-with-at-least-32-random-characters
# ENCRYPTION_KEY=replace-with-url-safe-base64-encoded-32-byte-key
# ALLOWED_ORIGINS=https://your-admin.example.com
# LOG_LEVEL=INFO
# BACKEND_WORKERS=1
# Experimental Web narrative workspace (requires migration 009).
NARRATIVE_BRANCHES_ENABLED=false
