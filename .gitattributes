# Repository text is normalized so frozen data hashes and generated evidence are
# identical on Windows and Linux. PowerShell remains CRLF for native tooling.
* text=auto eol=lf
*.ps1 text eol=crlf

# Hash-bound research assets must never follow the local core.autocrlf setting.
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf

# Preserve the pinned upstream MIT license byte-for-byte, including CRLF.
backend/inference/tokenizer_data/LICENSE.deepseek-v4-pro-0813 -text
