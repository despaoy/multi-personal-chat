# Explicit development profile. Existing saved admin settings take precedence over
# OPENAI_COMPAT_* defaults; review those settings when switching an existing database.
MODEL_PROVIDER=openai_compat
VLLM_ENABLED=false
OPENAI_COMPAT_BASE_URL=https://api.deepseek.com
OPENAI_COMPAT_MODEL=deepseek-flash
# Supply locally at runtime; never commit the real key.
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_CONTEXT_WINDOW_TOKENS=32768
VLLM_TOP_P=1.0
VLLM_TEMPERATURE=0.7
VLLM_MAX_TOKENS=2048
# Enable background processing only after the worker is configured and running.
CHARACTER_CHAT_BACKGROUND_ENABLED=false
MEMORY_LLM_ENABLED=false
RELATIONSHIP_LLM_ENABLED=false
SUMMARY_LLM_ENABLED=false
# Private memory retrieval requires PostgreSQL + pgvector and local model weights.
CHARACTER_CHAT_VECTORS_ENABLED=false
CHARACTER_CHAT_SOURCES_ENABLED=false
# Worker dispatch is independent of retrieval; enable after configuring Temporal and embeddings.
CHARACTER_SOURCE_INDEXING_ENABLED=false
CHARACTER_SEARCH_URL=http://127.0.0.1:9200
CHARACTER_SEARCH_INDEX=character-sources-v1
EMBEDDING_DEVICE=cpu
ALLOW_REMOTE_EMBEDDING_MODEL=false
# Only declare origins of model services you operate locally. Loopback is allowed by default.
# LOCAL_MODEL_ALLOWED_ORIGINS=http://192.168.166.171:8001
# EMBEDDING_MODEL_PATH=/home/boot/lhm/multipersonal-runtime/models/paraphrase-multilingual-MiniLM-L12-v2
